{
  "name": "gestor-personal",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @gestor/web dev",
    "dev:mobile": "pnpm --filter @gestor/mobile start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @gestor/db prisma:generate",
    "db:migrate": "pnpm --filter @gestor/db prisma:migrate",
    "docker:dev": "docker compose -f infra/docker-compose.dev.yml up --build",
    "docker:prod": "docker compose -f infra/docker-compose.prod.yml up -d --build"
  }
}

